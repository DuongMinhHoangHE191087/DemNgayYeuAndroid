<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ad_native_view_lo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:ignore="Overdraw">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@android:color/black"
        android:minHeight="50dp"
        android:orientation="vertical"
        android:scrollbars="none">

        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/ad_badge"
            style="@style/appplugin_AppTheme.AdAttribution"
            android:layout_marginStart="20dp"
            android:layout_marginTop="5dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@id/ad_headline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/ad_headline"/>

        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="50dp"
            android:ellipsize="end"
            android:fontFamily="@font/appplugin_inter_semi_bold"
            android:gravity="start"
            android:maxLines="1"
            android:tag="NativeAd.headline"
            android:textColor="@color/appplugin_white"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@id/ad_call_to_action"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ad_badge"
            tools:text="Google Ads" />

        <ImageView
            android:id="@+id/ad_app_icon"
            android:layout_width="@dimen/appplugin_icon_layout_width"
            android:layout_height="@dimen/appplugin_icon_layout_height"
            android:layout_marginStart="@dimen/appplugin_icon_layout_margin_end"
            android:layout_marginTop="40dp"
            android:adjustViewBounds="true"
            android:background="@drawable/appplugin_bg_circle"
            android:importantForAccessibility="no"
            android:outlineProvider="background"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/ad_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/appplugin_inter_regular"
            android:gravity="start"
            android:maxLines="2"
            android:tag="NativeAd.body"
            android:textColor="@color/appplugin_ad_body_text"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ad_badge"
            app:layout_constraintTop_toBottomOf="@id/ad_headline"
            tools:text="Google Ads mot hai ba bon nam sau bay tam chin muoi"/>

        <Button
            android:id="@+id/ad_call_to_action"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="25dp"
            android:background="@drawable/appplugin_bg_button_call_to_action_ad"
            android:fontFamily="@font/appplugin_purple_smile"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:tag="NativeAd.action"
            android:textColor="@color/appplugin_white"
            android:textSize="20sp"
            android:textAllCaps="true"
            app:cornerRadius="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Install" />

        <TextView
            android:id="@+id/ad_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:padding="5dp"
            android:textStyle="bold"
            android:textColor="@color/appplugin_white"
            android:background="@color/appplugin_ad_overlay_bg"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/ad_call_to_action" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.gms.ads.nativead.NativeAdView>