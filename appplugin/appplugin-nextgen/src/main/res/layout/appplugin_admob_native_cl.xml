<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    tools:ignore="Overdraw">

    <!-- NativeAdView giữ ID gốc -->
    <com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView
        android:id="@+id/ntcl_ntadview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/appplugin_white">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lo_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:layout_constraintTop_toTopOf="parent">
                <!-- Icon (ImageView thay vì ImageFilterView) -->
                <ImageView
                    android:id="@+id/ntcl_app_icon"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:round="8dp" />

                <!-- Headline -->
                <TextView
                    android:id="@+id/ntcl_headline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:gravity="start"
                    android:lines="1"
                    android:textColor="@color/appplugin_gnt_gray"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ntcl_app_icon"
                    app:layout_constraintTop_toTopOf="@id/ntcl_app_icon" />

                <!-- Advertiser -->
                <TextView
                    android:id="@+id/ntcl_advertiser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@id/ntcl_headline"
                    app:layout_constraintTop_toBottomOf="@id/ntcl_headline" />

                <!-- Rating -->
                <RatingBar
                    android:id="@+id/ntcl_stars"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="4dp"
                    android:background="@android:color/transparent"
                    android:lines="1"
                    android:numStars="5"
                    android:stepSize="0.1"
                    android:textColor="@color/appplugin_gnt_gray"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ntcl_app_icon"
                    app:layout_constraintTop_toBottomOf="@+id/ntcl_headline" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <!-- Body -->
            <TextView
                android:id="@+id/ntcl_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginTop="6dp"
                android:lines="2"
                android:textColor="@color/appplugin_gnt_gray"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lo_top"
                app:layout_goneMarginTop="8dp" />

            <!-- MediaView -->
            <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
                android:id="@+id/ntcl_media"
                android:layout_width="0dp"
                android:layout_height="200dp"
                app:layout_constraintTop_toBottomOf="@id/ntcl_body"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp" />

            <!-- Call to Action -->
            <Button
                android:id="@+id/ntcl_call_to_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/appplugin_bg_button_call_to_action_ad"
                android:fontFamily="@font/appplugin_purple_smile"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Price -->
            <TextView
                android:id="@+id/ntcl_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/appplugin_ad_price_placeholder"
                android:visibility="gone"
                android:textSize="12sp"
                android:background="@color/appplugin_ad_overlay_bg"
                android:padding="5dp"
                android:textColor="@color/appplugin_white"
                app:layout_constraintBottom_toBottomOf="@id/ntcl_call_to_action"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginBottom="4dp" />

            <!-- Store -->
            <TextView
                android:id="@+id/ntcl_store"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textSize="12sp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                app:layout_constraintBottom_toBottomOf="@id/ntcl_call_to_action"
                app:layout_constraintStart_toEndOf="@id/ntcl_price"
                android:layout_marginBottom="4dp" />

            <!-- Ad Attribution Badge (required by AdMob policy) -->
            <TextView
                android:id="@+id/ntcl_ad_badge"
                style="@style/appplugin_AppTheme.AdAttribution"
                android:importantForAccessibility="no"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>

    <!-- Collapse layout -->
    <RelativeLayout
        android:id="@+id/ntlo_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="start"
        android:gravity="center">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_centerInParent="true"
            android:background="@drawable/appplugin_ic_collapse"
            android:importantForAccessibility="no" />

        <Button
            android:id="@+id/ntcl_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerInParent="true"
            android:background="@color/appplugin_transparent" />
    </RelativeLayout>

</FrameLayout>
