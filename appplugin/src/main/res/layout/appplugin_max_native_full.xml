<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@android:color/black"
    android:minHeight="50dp"
    android:scrollbars="none">

    <FrameLayout
        android:id="@+id/ad_media"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/ad_badge"
        style="@style/appplugin_AppTheme.AdAttribution"
        android:layout_marginLeft="3dp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/ad_headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:ellipsize="end"
        android:singleLine="true"
        tools:text="Ad Headline"
        android:textColor="@color/appplugin_ad_headline_max"
        android:textSize="@dimen/appplugin_headline_text_size"
        android:textStyle="bold"
        app:layout_constraintLeft_toRightOf="@id/ad_badge"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ad_app_icon"
        android:layout_width="@dimen/appplugin_icon_layout_width"
        android:layout_height="@dimen/appplugin_icon_layout_height"
        android:layout_marginStart="@dimen/appplugin_icon_layout_margin_end"
        android:layout_marginTop="40dp"
        android:adjustViewBounds="true"
        android:background="@drawable/appplugin_bg_circle"
        android:importantForAccessibility="no"
        android:outlineProvider="background"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/ad_call_to_action"
        android:layout_width="200dp"
        android:layout_height="40dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/appplugin_bg_bound"
        android:gravity="center"
        tools:text="Install"
        android:textColor="@color/appplugin_white"
        android:textSize="@dimen/appplugin_cta_button_text_size"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/ad_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@color/appplugin_ad_overlay_bg"
        android:padding="5dp"
        android:textColor="@color/appplugin_white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/ad_call_to_action"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>