<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="400dp"
    android:background="@color/appplugin_white">

    <FrameLayout
        android:id="@+id/ntcl_lo"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <RelativeLayout
        android:id="@+id/ntlo_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="start"
        android:gravity="center">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_centerInParent="true"
            android:background="@drawable/appplugin_icon_down" />

        <Button
            android:id="@+id/ntcl_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerInParent="true"
            android:background="@color/appplugin_transparent" />
    </RelativeLayout>
</FrameLayout>