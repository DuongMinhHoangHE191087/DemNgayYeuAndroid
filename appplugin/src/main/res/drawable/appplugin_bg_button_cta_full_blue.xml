<?xml version="1.0" encoding="utf-8"?>
<!-- Blue variant of bg_button_call_to_action_ad.xml, scoped to admob_native_full.xml
     only so the other five layouts that share the green drawable are unaffected. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/appplugin_ad_cta_blue_base" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/appplugin_ad_cta_blue_top"
                android:centerColor="@color/appplugin_ad_cta_blue_mid"
                android:endColor="@color/appplugin_ad_cta_blue_base" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
