<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- FirebaseAnalytics.getInstance (AnalyticsConsent) khai @RequiresPermission WAKE_LOCK. App vốn đã có quyền
         này qua manifest của play-services-measurement / firebase-iid; khai ở đây để lint của SDK thấy. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application android:supportsRtl="true">
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true"/>

        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true"/>

        <!-- Meta SDK (facebook-core, nếu app có khai) không tự khởi tạo, không tự ghi app event
             và không thu advertising id trước consent. MetaSdkStarter bật lại sau khi UMP cho
             phép. App nào muốn khác phải ghi đè bằng tools:replace, tức là chọn có chủ đích. -->
        <meta-data
            android:name="com.facebook.sdk.AutoInitEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AutoLogAppEventsEnabled"
            android:value="false" />
        <meta-data
            android:name="com.facebook.sdk.AdvertiserIDCollectionEnabled"
            android:value="false" />

        <!-- Consent Mode v2: từ chối cho tới khi AnalyticsConsent.apply() đặt theo tầng consent, sau
             khi UMP trả lời (Điều 13.3, doc 60 E). FCM auto-init tắt tới lúc đó; AdSdkStartup
             bật lại khi tầng cho phép (FcmConsent). App nào muốn khác phải ghi đè bằng tools:replace. -->
        <meta-data android:name="google_analytics_default_allow_analytics_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_user_data" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
    </application>
</manifest>