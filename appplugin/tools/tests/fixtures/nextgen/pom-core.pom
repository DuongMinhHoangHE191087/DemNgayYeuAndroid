<?xml version="1.0" encoding="UTF-8"?>
<project>
  <groupId>com.app.plugin</groupId>
  <artifactId>appplugin-nextgen</artifactId>
  <version>2.4.0</version>
  <dependencies>
    <dependency>
      <groupId>com.google.android.libraries.ads.mobile.sdk</groupId>
      <artifactId>ads-mobile-sdk</artifactId>
      <version>1.5.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.google.ads.mediation</groupId>
      <artifactId>facebook</artifactId>
      <version>6.22.0.1</version>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <groupId>com.google.android.gms</groupId>
          <artifactId>play-services-ads</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.app.plugin</groupId>
      <artifactId>appplugin</artifactId>
      <version>2.4.0</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>
</project>
