<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Chỉ ảnh/video kỷ niệm và bản kê memories_backup.json (nằm trong files/media) được sao lưu; DB và khóa đăng nhập không bao giờ.
         Đã có include thì mọi thứ ngoài nó tự bị loại, nên không khai báo exclude (lint FullBackupContent báo lỗi exclude nằm ngoài include). -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="media" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="media" />
    </device-transfer>
</data-extraction-rules>
