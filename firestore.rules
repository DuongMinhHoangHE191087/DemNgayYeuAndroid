rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user is a member of the relationship (supports partnerA/B, user1/2, and 3NF user1Uid/user2Uid).
    // get(key, '') so a missing legacy field is a plain non-match, not a rule evaluation error.
    function isRelationshipMember(relData) {
      return isAuthenticated() && (
        request.auth.uid == relData.get('partnerAId', '') ||
        request.auth.uid == relData.get('partnerBId', '') ||
        request.auth.uid == relData.get('user1', '') ||
        request.auth.uid == relData.get('user2', '') ||
        request.auth.uid == relData.get('user1Uid', '') ||
        request.auth.uid == relData.get('user2Uid', '')
      );
    }

    // Check if user is authorized for a memory item
    function isMemoryMember(memData) {
      return isAuthenticated() && (
        request.auth.uid == memData.authorUid ||
        request.auth.uid == memData.partnerUid ||
        (memData.relationshipId != null && memData.relationshipId != "" &&
         exists(/databases/$(database)/documents/relationships/$(memData.relationshipId)) &&
         isRelationshipMember(get(/databases/$(database)/documents/relationships/$(memData.relationshipId)).data))
      );
    }

    // Check if user is authorized for an anniversary item
    function isAnniversaryMember(anniData) {
      return isAuthenticated() && (
        request.auth.uid == anniData.authorUid ||
        request.auth.uid == anniData.userId ||
        (anniData.relationshipId != null && anniData.relationshipId != "" &&
         exists(/databases/$(database)/documents/relationships/$(anniData.relationshipId)) &&
         isRelationshipMember(get(/databases/$(database)/documents/relationships/$(anniData.relationshipId)).data))
      );
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Users Collection (Strict privacy: owner-only access)
    // ===============================================================
    // Entitlement/role fields (isVip, subscriptionTier, role, ...) are server-owned: they
    // are in NO allowlist below, so a client can never create, modify or delete them
    // (writes only via Admin SDK / trusted backend, which bypasses rules).
    // The app does not currently write users/{uid} from the client; this allowlist mirrors
    // the profile fields of OnlineUserEntity minus entitlement fields.
    function userProfileFields() {
      return ['uid', 'displayName', 'email', 'coupleCode', 'partnerId', 'relationshipId',
              'status', 'interests', 'interestsCsv', 'avatarUrl', 'gender', 'birthDate',
              'age', 'zodiac', 'bio', 'isProfileSetup', 'createdAt', 'updatedAt'];
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(userProfileFields()) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId);
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(userProfileFields()) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId);
      allow delete: if isOwner(userId);
    }

    // ===============================================================
    // Couple Codes (public lookup: code -> ownerUid, needed for real
    // two-device pairing since `users` is owner-only readable)
    // ===============================================================
    match /coupleCodes/{code} {
      allow get: if isAuthenticated();
      allow list: if false; // never enumerable — only direct get by a known code
      allow create: if isAuthenticated() &&
        request.resource.data.ownerUid == request.auth.uid &&
        !exists(/databases/$(database)/documents/coupleCodes/$(code));
      allow update: if false; // codes are immutable; regenerate = delete + create new
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // ===============================================================
    // Relationships Collection
    // ===============================================================
    match /relationships/{relationshipId} {
      allow get, list: if isRelationshipMember(resource.data);
      // Chỉ Cloud Function `acceptCoupleInvite` (Admin SDK, bỏ qua rules) được tạo relationship:
      // nó nhận lời mời + tạo relationship (id = id lời mời) trong một transaction và ép
      // "mỗi uid một quan hệ đang hoạt động". Client tự tạo sẽ không có transaction đó.
      // Phải deploy function TRƯỚC khi deploy rules này / phát hành app dùng nó.
      allow create: if false;
      // Khoá TẤT CẢ field xác định thành viên — thiếu partnerAId/partnerBId trước đây cho
      // phép một partner tự thay thế người kia bằng một uid bất kỳ (chiếm quyền đọc toàn bộ
      // memories/anniversaries đã gắn relationshipId này).
      allow update: if isRelationshipMember(resource.data) &&
        !(resource.data.status == 'TERMINATED' && request.resource.data.status == 'ACTIVE') &&
        (!('partnerAId' in resource.data) || request.resource.data.partnerAId == resource.data.partnerAId) &&
        (!('partnerBId' in resource.data) || request.resource.data.partnerBId == resource.data.partnerBId) &&
        (!('user1' in resource.data) || request.resource.data.user1 == resource.data.user1) &&
        (!('user2' in resource.data) || request.resource.data.user2 == resource.data.user2) &&
        (!('user1Uid' in resource.data) || request.resource.data.user1Uid == resource.data.user1Uid) &&
        (!('user2Uid' in resource.data) || request.resource.data.user2Uid == resource.data.user2Uid);
      allow delete: if isRelationshipMember(resource.data);
    }

    // ===============================================================
    // Shared content subcollections of a relationship (Task 5's
    // MemorySyncAdapter/AnniversarySyncAdapter write/listen here — distinct
    // from the top-level /memories, /anniversaries collections below).
    // Both partners get full read/write; no sender/receiver asymmetry here.
    // ===============================================================
    function isActiveRelMember(relId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/relationships/$(relId)) &&
        isRelationshipMember(get(/databases/$(database)/documents/relationships/$(relId)).data) &&
        get(/databases/$(database)/documents/relationships/$(relId)).data.status == 'ACTIVE';
    }

    // Media helpers (docs/architecture/MEDIA_CLOUDINARY.md). A client may never store a public
    // link or a device path in a memory: photoUri is empty or a preset photo, videoUri is always
    // empty (video lives in Cloudinary under cloudinaryPublicId).
    function isPresetPhoto(url) {
      return exists(/databases/$(database)/documents/preset_assets/photos) &&
        url in get(/databases/$(database)/documents/preset_assets/photos).data.urls;
    }

    function mediaFieldsAllowed(data) {
      return !('cloudinaryUrl' in data) &&
        !('isCloudinaryStored' in data) &&
        data.get('videoUri', '') == '' &&
        (data.get('photoUri', '') == '' || isPresetPhoto(data.photoUri));
    }

    // The server confirmed this upload, it is still active, it belongs to this couple, and the
    // caller is the one who uploaded it.
    function ownsActiveAsset(memId, relId) {
      let asset = get(/databases/$(database)/documents/mediaAssets/$(memId)).data;
      return asset.state == 'active' && asset.relationshipId == relId && asset.ownerUid == request.auth.uid;
    }

    // Reads stay open to members of any status (so a terminated couple can still see history
    // locally-synced); writes require an ACTIVE relationship and a doc that names this relationship.
    // cloudinaryPublicId may be set only at create, only to inlove_mem_<this id>, and only with a
    // confirmed asset. Afterwards it may stay the same or be cleared; it cannot be attached to a new file.
    match /relationships/{relId}/memories/{memId} {
      allow read: if isAuthenticated() &&
        exists(/databases/$(database)/documents/relationships/$(relId)) &&
        isRelationshipMember(get(/databases/$(database)/documents/relationships/$(relId)).data);
      allow create: if isActiveRelMember(relId) &&
        request.resource.data.relationshipId == relId &&
        request.resource.data.syncId == memId &&
        request.resource.data.authorId == request.auth.uid &&
        mediaFieldsAllowed(request.resource.data) &&
        (request.resource.data.get('cloudinaryPublicId', '') == '' ||
         (request.resource.data.cloudinaryPublicId == 'inlove_mem_' + memId && ownsActiveAsset(memId, relId)));
      allow update: if isActiveRelMember(relId) &&
        request.resource.data.relationshipId == relId &&
        request.resource.data.syncId == memId &&
        request.resource.data.get('authorId', '') == resource.data.get('authorId', '') &&
        mediaFieldsAllowed(request.resource.data) &&
        (request.resource.data.get('cloudinaryPublicId', '') == '' ||
         request.resource.data.cloudinaryPublicId == resource.data.get('cloudinaryPublicId', ''));
      allow delete: if isActiveRelMember(relId);
    }

    match /relationships/{relId}/anniversaries/{annId} {
      allow read: if isAuthenticated() &&
        exists(/databases/$(database)/documents/relationships/$(relId)) &&
        isRelationshipMember(get(/databases/$(database)/documents/relationships/$(relId)).data);
      allow create, update: if isActiveRelMember(relId) &&
        request.resource.data.relationshipId == relId &&
        request.resource.data.syncId == annId;
      allow delete: if isActiveRelMember(relId);
    }

    // ===============================================================
    // Invites Collection (Couple Pairing: only sender and receiver)
    // ===============================================================
    match /invites/{inviteId} {
      allow get, list: if isAuthenticated() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid ||
        resource.data.targetUid == request.auth.uid
      );
      // Always created PENDING and addressed to someone else: a client can never mint an
      // already-ACCEPTED invite (that would let it force a relationship onto a victim).
      allow create: if isAuthenticated() && request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.targetUid != request.auth.uid;
      // Receiver may only move PENDING -> ACCEPTED/DECLINED. Sender may only move
      // PENDING -> CANCELLED. Identity fields stay locked as before.
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.senderUid == resource.data.senderUid &&
        (!('receiverUid' in resource.data) || request.resource.data.receiverUid == resource.data.receiverUid) &&
        (!('targetUid' in resource.data) || request.resource.data.targetUid == resource.data.targetUid) &&
        resource.data.status == 'PENDING' && (
          ((resource.data.receiverUid == request.auth.uid || resource.data.targetUid == request.auth.uid) &&
           request.resource.data.status in ['ACCEPTED', 'DECLINED']) ||
          (resource.data.senderUid == request.auth.uid && request.resource.data.status == 'CANCELLED')
        );
      allow delete: if isAuthenticated() && resource.data.senderUid == request.auth.uid;
    }

    // ===============================================================
    // Memories Collection (legacy top-level; Strict membership check: author or partner only)
    // ===============================================================
    match /memories/{memoryId} {
      allow get, list: if isMemoryMember(resource.data);
      // The app writes memories only under relationships/{id}/memories. New rows here are refused;
      // the author may still delete their own rows (RemoteAccountCleanup on account deletion).
      allow create, update: if false;
      allow delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
    }

    // ===============================================================
    // Anniversaries Collection (Author or Relationship Member only)
    // ===============================================================
    match /anniversaries/{anniversaryId} {
      allow get, list: if isAnniversaryMember(resource.data);
      allow create: if isAuthenticated() && (
        request.resource.data.authorUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        (request.resource.data.relationshipId != null &&
         exists(/databases/$(database)/documents/relationships/$(request.resource.data.relationshipId)) &&
         isRelationshipMember(get(/databases/$(database)/documents/relationships/$(request.resource.data.relationshipId)).data))
      );
      allow update: if isAnniversaryMember(resource.data) &&
        (!('authorUid' in resource.data) || request.resource.data.authorUid == resource.data.authorUid) &&
        (!('relationshipId' in resource.data) || request.resource.data.relationshipId == resource.data.relationshipId);
      allow delete: if isAnniversaryMember(resource.data);
    }

    // ===============================================================
    // Public / Shared Catalog Collections (Read: Public, Write: Denied)
    // ===============================================================
    match /gift_ideas/{giftId} {
      allow read: if true;
      allow write: if false;
    }

    match /milestone_presets/{milestoneId} {
      allow read: if true;
      allow write: if false;
    }

    match /badge_definitions/{badgeId} {
      allow read: if true;
      allow write: if false;
    }

    match /preset_assets/{assetId} {
      allow read: if true;
      allow write: if false;
    }

    match /checklist_templates/{checklistId} {
      allow read: if true;
      allow write: if false;
    }

    // ===============================================================
    // Media bookkeeping (written only by Cloud Functions; Admin SDK bypasses rules)
    // ===============================================================
    match /mediaAssets/{assetId} {
      allow read, write: if false;
    }

    match /mediaQuota/{quotaId} {
      allow read, write: if false;
    }

    // Việc xoá tài khoản: chỉ callable `requestAccountDeletion` + trigger (Admin SDK) ghi; client không đọc/ghi.
    match /accountDeletions/{uid} {
      allow read, write: if false;
    }

    // ===============================================================
    // Test Account Fixtures (Locked down: zero client access)
    // ===============================================================
    match /test_fixtures/{fixtureId} {
      allow read, write: if false;
    }
  }
}
