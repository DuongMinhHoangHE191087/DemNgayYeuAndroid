# ===================================================================
# InLove Android Configuration (.env)
# ===================================================================

# 1. Gemini AI API Key (Tùy chọn nếu dùng tính năng trợ lý AI tình yêu)
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 2. Ảnh & video kỷ niệm: app KHÔNG cần khóa Cloudinary. Khóa API/secret và chế độ phân phát
# nằm trong Firebase Secret Manager (xem docs/architecture/MEDIA_CLOUDINARY.md), không đặt ở đây.

# 3. Email xác thực/đặt lại mật khẩu do Firebase Auth gửi; app KHÔNG chứa SMTP credentials.

# 4. scripts/seed_firestore.js — mật khẩu tài khoản test seed lên Firestore (test_fixtures).
# BẮT BUỘC phải đặt trước khi chạy `npm run seed` — không có giá trị mặc định, script sẽ
# dừng ngay nếu thiếu. Không dùng lại các mật khẩu này cho tài khoản thật.
SEED_TESTER_PRIMARY_PASSWORD=""
SEED_TESTER_PARTNER_PASSWORD=""
SEED_TESTER_VIP_PASSWORD=""
SEED_TESTER_FREE_PASSWORD=""
SEED_ADMIN_PASSWORD=""

# 5. Domain HTTPS do bạn kiểm soát, phải có các trang /privacy, /terms, /delete-account trước khi phát hành.
LEGAL_BASE_URL=https://inloveapp.com
