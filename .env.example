# ===================================================================
# InLove Android Configuration (.env)
# ===================================================================

# 1. Gemini AI API Key (Tùy chọn nếu dùng tính năng trợ lý AI tình yêu)
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 2. Cloudinary Media Storage (Lưu trữ ảnh & video đám mây)
# Unsigned preset inlove_unsigned trên cloud dt6p7wm6i
CLOUDINARY_CLOUD_NAME=dt6p7wm6i
CLOUDINARY_UPLOAD_PRESET=inlove_unsigned
CLOUDINARY_FOLDER=inlove_memories

# 3. SMTP Real Email Service (Gửi email xác thực OTP THẬT đến khách hàng)
# Hướng dẫn tạo mật khẩu ứng dụng Gmail: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER_EMAIL=""
SMTP_SENDER_PASSWORD=""
SMTP_SENDER_NAME="InLove App"
