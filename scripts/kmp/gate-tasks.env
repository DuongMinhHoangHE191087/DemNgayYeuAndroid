# Task names of :shared, chot boi F-02 bang `./gradlew :shared:tasks --all` (A3). Sourceable from bash.
# Dung: `. scripts/kmp/gate-tasks.env; ./gradlew ":shared:${HOST_TEST_TASK}"`. Khong hard-code ten task o noi khac.

# Task test chung chay duoc tren Windows (host test cua target android).
HOST_TEST_TASK=testAndroidHostTest
# Task + lop test DB. Mac dinh bang HOST_TEST_TASK; F-04 doi neu phai dung phuong an jvm().
DB_TEST_TASK=testAndroidHostTest
DB_TEST_CLASS=com.example.spike.SpikeDbAndroidTest

# Task iOS. Tren Windows chi COMPILE klib chay that (IOS_KLIB_TASK); iosSimulatorArm64Test va link la SKIPPED (can Mac).
# Ten task deu duoc liet ke boi `:shared:tasks --all` tren Windows (cung voi kotlin.native.ignoreDisabledTargets=true).
IOS_TEST_TASK=iosSimulatorArm64Test
IOS_LINK_TASK=linkDebugFrameworkIosSimulatorArm64
IOS_KLIB_TASK=compileKotlinIosSimulatorArm64
# yes = IOS_KLIB_TASK chay duoc tren Windows (da do, can co file nguon).
IOS_KLIB_ON_WINDOWS=yes

# Configuration classpath compile cua target android (tu `:shared:dependencies`; plan ghi androidMainCompileClasspath la sai).
ANDROID_CLASSPATH_CONFIG=androidCompileClasspath
FORBID_COMPOSE_ON_ANDROID_CLASSPATH=1

# Noi DUY NHAT dat ten simulator (DEC-220). Khong script nao dat o noi khac.
IOS_SIM_DEVICE="${IOS_SIM_DEVICE:-iPhone 17}"
IOS_SIM_DEST="platform=iOS Simulator,name=$IOS_SIM_DEVICE"
